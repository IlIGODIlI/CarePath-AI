# CarePath AI Backend Environment Configuration

# Project Metadata
PROJECT_NAME="CarePath AI Backend"
ENVIRONMENT="development"  # development, staging, production
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL Async)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="carepath_admin"
POSTGRES_PASSWORD="secure_password_change_me"
POSTGRES_DB="carepath_db"
DATABASE_URL="postgresql+asyncpg://carepath_admin:secure_password_change_me@localhost:5432/carepath_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Authentication & Security
SECRET_KEY="replace_with_a_super_secret_key_generate_using_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security & CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://carepath.ai"]

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=["pdf","png","jpg","jpeg","dicom"]

# PHI Encryption Salt
PHI_SALT="salt_for_phi_hashing_and_redaction"

# AI Service Adapters (Sprint 2 Plugins)
VISION_SERVICE_URL="http://localhost:8001/api/v1/vision"
OCR_SERVICE_URL="http://localhost:8002/api/v1/ocr"
CHROMA_HOST="localhost"
CHROMA_PORT=8000
