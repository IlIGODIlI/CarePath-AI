# App Environment Settings
APP_ENV=development
DEBUG=True
PROJECT_NAME="CarePath AI Backend"
API_V1_STR="/api/v1"

# Security & JWT Secrets
SECRET_KEY="super_secret_temporary_key_change_in_production_1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Config
HOST="0.0.0.0"
PORT=8000
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# PostgreSQL Database Configuration
POSTGRES_USER=carepath_admin
POSTGRES_PASSWORD=carepath_secret_pass
POSTGRES_DB=carepath_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://carepath_admin:carepath_secret_pass@localhost:5432/carepath_db

# Storage Directories
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=[".pdf", ".jpg", ".jpeg", ".png", ".dcom", ".txt"]
