# PostgreSQL connection string from Supabase (Settings -> Database -> Connection string)
# Note: Use the Transaction connection pooler string if using connection pooling.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase API Settings (Settings -> API -> Project URL and anon/public key)
SUPABASE_URL=
SUPABASE_KEY=
