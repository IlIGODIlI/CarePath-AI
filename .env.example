# Core App Environment Settings
APP_ENV=development
DEBUG=true
PROJECT_NAME="CarePath AI Backend"
API_V1_STR="/api/v1"
SECRET_KEY="super_secret_temporary_key_change_in_production_1234567890"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Config
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# PostgreSQL Database Configuration
POSTGRES_USER=carepath_admin
POSTGRES_PASSWORD=carepath_secret_pass
POSTGRES_DB=carepath_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://carepath_admin:carepath_secret_pass@postgres:5432/carepath_db

# Vector Store (ChromaDB) Configuration
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_COLLECTION=clinical_guidelines_v1

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Gemini API Credential
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL_NAME=gemini-1.5-pro
